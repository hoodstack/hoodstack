    "@hoodstack/config": "workspace:*",
    "@hoodstack/db": "workspace:*",
    "@hoodstack/design-tokens": "workspace:*",
    "@hoodstack/errors": "workspace:*",
    "@hoodstack/network": "workspace:*",
    "@privy-io/react-auth": "^2.0.0",
    "@privy-io/server-auth": "^1.18.0",
    "@upstash/ratelimit": "^2.0.3",
    "@upstash/redis": "^1.34.3",
    "next": "^15.1.3",
    "permissionless": "^0.2.57",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
