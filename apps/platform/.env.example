# HoodStack platform — environment
#
# Copy to `.env.local` and fill in. Never commit real values: `.env*` is
# gitignored (this example is the one exception). In production these are set in
# the Vercel project settings, not in a file.

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# From the Supabase dashboard → Project settings → Database → Connection string.
# DATABASE_URL is the POOLED connection (Transaction mode, port 6543) used by the
# app at runtime. DIRECT_URL is the DIRECT connection (port 5432) used only for
# running migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# ── Auth (Privy) ─────────────────────────────────────────────────────────────
# From the Privy dashboard → your app → Settings. The app id is public (shipped
# to the browser); the secret is server-only and must never be exposed.
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# ── Rate limiting (Upstash Redis) ────────────────────────────────────────────
# From the Upstash console → your Redis database → REST API.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Chain RPC (optional overrides) ───────────────────────────────────────────
# The gateway defaults to the public Robinhood Chain endpoints defined in
# @hoodstack/network. Set these to a dedicated provider endpoint for production
# throughput. Leave blank to use the public endpoints.
HOODSTACK_RPC_URL_MAINNET=""
HOODSTACK_RPC_URL_TESTNET=""

# ── Marketing widgets (already used by the site) ─────────────────────────────
# Public project id the marketing stack-diagram / docs samples display. Not a
# secret; safe to expose.
NEXT_PUBLIC_HOODSTACK_PROJECT_ID="demo"
